// Per-process resources, containers, tool arguments and output folders.
// Anything that reads params is a { } closure, so command-line and profile values apply.
process {

    cpus   = 1
    memory = 4.GB
    time   = 4.h

    // no task will ask for more than --max_cpus / --max_memory / --max_time.
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time as nextflow.util.Duration
    ]

    // Out-of-memory or killed tasks are retried with more memory with each attempt; other errors stop the run.
    errorStrategy = { task.exitStatus in [104,134,137,138,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // ---- Resources ----
    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 32.GB * task.attempt }
        time   = 12.h
    }
    withLabel: process_long {
        time = 24.h
    }
    // Steps whose memory grows with the number of samples (a run is considered large if more than ~450-samples)
    withName: 'MULTIQC' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'PAPERMILL_SNP_DATAFRAME|PAPERMILL_SAMPLE_QUALITY_CONTROL|PAPERMILL_GENETIC_DIVERSITY|PAPERMILL_POPULATION_STRUCTURE|PAPERMILL_ALLELE_FREQUENCIES|PAPERMILL_SPECIES_ID|PAPERMILL_KDR_ANALYSIS' {
        memory = { 24.GB * task.attempt }
    }
    // Steps that can fail transiently, such as downloads:
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 1
    }

    // ---- Containers ----
    // nf-core modules bring their own containers; only the rest are set here.
    // bcl2fastq keeps 4 files open per sample, which passes docker's default open-file limit on large runs
    withName: 'BCL_CONVERT_RUN' {
        container        = { "${params.container_registry}/bcl2fastq:${params.container_tag}" }
        containerOptions = { workflow.containerEngine == 'docker' ? '--ulimit nofile=65536:65536' : '' }
    }
    withName: 'JUPYTER_BOOK' {
        container = { "${params.container_registry}/jupyterbook:${params.container_tag}" }
    }
    withName: 'PAPERMILL_.*|BCL_MERGE_FASTQS|CREATE_PLOIDY_FILE|METADATA_COLOURS|BUILD_METADATA|BUILD_CONFIG_SUMMARY' {
        container = { "${params.container_registry}/python:${params.container_tag}" }
    }

    withName: 'BCFTOOLS_MPILEUP_CALL|MASK_CLAIR3_GVCF|BCFTOOLS_DROP_NON_REF' {
        container = 'quay.io/biocontainers/bcftools:1.21--h3a4d415_1'
    }
    withName: 'SNPEFF_.*' {
        container = 'quay.io/biocontainers/snpeff:5.1--hdfd78af_4'
    }
    withName: 'FASTQC_INDEX_READS' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    // Tool arguments
    withName: 'BWA_ALIGN' {
        ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPU:nye\\tPL:nye\\tLB:${meta.id}_lb${meta.id}'" }
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args = { "-ax map-ont -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ONT\\tLB:${meta.id}_lib'" }
    }
    withName: 'BCFTOOLS_MPILEUP_CALL' {
        ext.args = { params.platform == 'nanopore' ? '-X ont-sup' : '' }
    }
    // Clair3 occasionally crashes randomly: retry twice, if it doesn't work, skip the sample rather than stop the run
    withName: 'CLAIR3' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        ext.args = { "--include_all_ctgs --gvcf --sample_name=${meta.id}" + (params.ploidy.toString() == '1' ? ' --no_phasing_for_fa --haploid_sensitive' : '') }
    }
    // Nanopore amplicon calls are gVCFs; -g keeps covered samples 0/0 and samples with no data ./.
    withName: 'BCFTOOLS_MERGE.*' {
        ext.args = { '--force-samples -Ov' + (params.platform == 'nanopore' && meta.call_type == 'amplicons' ? " -g ${params.reference_fasta.toString().tokenize('/')[-1]}" : '') }
    }
    withName: 'BCFTOOLS_STATS' {
        ext.prefix = { "${meta.id}-${meta.call_type}.merged.vcf" }
    }

    // ---- Output folders ----
    // Default is <outdir>/<process name>; the notebooks expect the layout below, so don't change it!
    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: 'BUILD_METADATA|METADATA_COLOURS' {
        publishDir = [ path: { "${params.outdir}/config" }, mode: params.publish_dir_mode ]
    }
    withName: 'BCL_MERGE_FASTQS' {
        publishDir = [ path: { "${params.reads_dir}" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQC_INDEX_READS' {
        publishDir = [ path: { "${params.outdir}/qc/index-read-qc" }, mode: params.publish_dir_mode ]
    }
    withName: 'BWA_ALIGN|MINIMAP2_ALIGN|SAMTOOLS_INDEX' {
        publishDir = [ path: { "${params.outdir}/alignments" }, mode: params.publish_dir_mode ]
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [ path: { "${params.outdir}/alignments/bamStats" }, mode: params.publish_dir_mode ]
    }
    withName: 'MOSDEPTH' {
        publishDir = [ path: { "${params.outdir}/coverage" }, mode: params.publish_dir_mode ]
    }
    withName: 'CREATE_PLOIDY_FILE' {
        publishDir = [ path: { "${params.outdir}/config" }, mode: params.publish_dir_mode ]
    }
    withName: 'SNPEFF_DB_DOWNLOAD|SNPEFF_CUSTOM_DB' {
        publishDir = [ path: { "${params.outdir}/vcfs/annotations" }, mode: params.publish_dir_mode ]
    }
    withName: 'BCFTOOLS_MPILEUP_CALL|BGZIP_TABIX_CALLS' {
        publishDir = [
            path: { "${params.outdir}/vcfs/${meta.call_type}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'FASTP|FASTPLONG' {
        publishDir = [
            [ path: { "${params.outdir}/trimmed-reads" },   mode: params.publish_dir_mode, pattern: '*.fastq.gz' ],
            [ path: { "${params.outdir}/qc/fastp_reports" }, mode: params.publish_dir_mode, pattern: '*.{json,html}',
              saveAs: { fn -> fn.endsWith('.html') ? "${meta.id}.html" : fn } ]
        ]
    }
    withName: 'SNPEFF_ANNOTATE|MASK_CLAIR3_GVCF|BCFTOOLS_DROP_NON_REF' {
        publishDir = [
            path: { "${params.outdir}/vcfs/${meta.call_type}" },
            mode: params.publish_dir_mode
        ]
    }
    // Not published for nanopore amplicons: BCFTOOLS_DROP_NON_REF publishes the final file instead.
    withName: 'BCFTOOLS_MERGE' {
        publishDir = [
            path: { "${params.outdir}/vcfs/${meta.call_type}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> params.platform == 'nanopore' && meta.call_type == 'amplicons' ? null : fn }
        ]
    }
    withName: 'CLAIR3' {
        publishDir = [
            path: { "${params.outdir}/vcfs/amplicons" },
            mode: params.publish_dir_mode,
            pattern: '*merge_output.gvcf.gz',
            saveAs: { fn -> "${meta.id}.clair3.g.vcf.gz" }
        ]
    }
    withName: 'BCFTOOLS_STATS' {
        publishDir = [ path: { "${params.outdir}/qc" }, mode: params.publish_dir_mode ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/qc/multiqc" }, mode: params.publish_dir_mode ]
    }
    // Executed notebooks, plus the tables and plots they write.
    withName: 'PAPERMILL_.*' {
        publishDir = [
            [ path: { "${params.outdir}/notebooks" },         mode: params.publish_dir_mode, pattern: '*.ipynb' ],
            [ path: 'docs/ampseeker-results/notebooks',       mode: params.publish_dir_mode, pattern: '*.ipynb' ],
            [ path: { "${params.outdir}" }, mode: params.publish_dir_mode,
              pattern: '{*.tsv,**/*.tsv,*.xlsx,**/*.xlsx,*.png,**/*.png}',
              saveAs: { fn -> fn?.startsWith('results/') ? fn.substring('results/'.length()) : null } ]
        ]
    }
    // Must stay below PAPERMILL_.*
    withName: 'PAPERMILL_SPECIES_ID|PAPERMILL_KDR_ANALYSIS' {
        publishDir = [
            [ path: { "${params.outdir}/notebooks/ag-vampir" }, mode: params.publish_dir_mode, pattern: '*.ipynb' ],
            [ path: 'docs/ampseeker-results/notebooks/ag-vampir', mode: params.publish_dir_mode, pattern: '*.ipynb' ],
            [ path: { "${params.outdir}" }, mode: params.publish_dir_mode,
              pattern: '{*.tsv,**/*.tsv,*.xlsx,**/*.xlsx,*.png,**/*.png}',
              saveAs: { fn -> fn?.startsWith('results/') ? fn.substring('results/'.length()) : null } ]
        ]
    }
    withName: 'JUPYTER_BOOK' {
        publishDir = [ path: { "${params.outdir}" }, mode: params.publish_dir_mode ]
    }
}
