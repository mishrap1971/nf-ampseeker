// Settings for -profile test: a tiny dataset that exercises the whole workflow (meant for -stub or quick checks).
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal dataset to exercise the full DAG'

    dataset        = 'test'
    platform       = 'illumina'
    ploidy         = 2
    panel          = 'ag-vampir'
    cohort_columns = ['location','taxon','country']

    from_bcl   = false
    metadata   = "${projectDir}/assets/test/metadata.tsv"
    targets    = "${projectDir}/assets/test/ag-vampir.bed"

    reference_name     = 'AgamP4'
    reference_fasta    = "${projectDir}/assets/test/AgamP4.subset.fa"
    reference_gff3     = "${projectDir}/assets/test/AgamP4.subset.gff"
    reference_snpeffdb = 'Anopheles_gambiae'
    custom_snpeffdb    = true

    qc_coverage = true
    qc_stats    = true
    qc_multiqc  = true

    analysis_population_structure = true
    analysis_genetic_diversity    = true
    analysis_allele_frequencies   = true
    analysis_sample_map           = false

    build_jupyter_book = true

    outdir = 'results_test'
}

// Keep resource requests small so the test fits on a typical laptop CPU
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
