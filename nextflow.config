// Default user settings. Override on the command line (--argument value) or with -params-file.
params {

    // What is being analysed: dataset name, sequencing platform, ploidy, optional panel and the cohort columns used for plots.
    dataset          = 'natcomms'
    platform         = 'illumina'
    ploidy           = 2
    min_genotype_depth = 10      // nanopore only: Clair3 genotypes below this read depth are set to missing, not wild type
    panel            = null
    cohort_columns   = ['location','taxon','country']
    targets          = null

    // Inputs: sample metadata table, or Illumina run folders to demultiplex (from_bcl).
    metadata         = null
    illumina_dir     = []
    from_bcl         = false
    reads_dir        = 'resources/reads'
    metadata_colours = null

    // Reference genome files, and how to get the snpEff annotation database (build from the GFF, or download by name).
    reference_name     = null
    reference_fasta    = null
    reference_gff3     = null
    reference_snpeffdb = null
    custom_snpeffdb    = false
    clair3_model_path  = null

    // Switches for individual QC steps.
    qc_fastp        = true
    qc_coverage     = true
    qc_stats        = true
    qc_multiqc      = true
    qc_sample_min_mean_target_coverage = 5

    // Switches for individual analysis notebooks (the sample map needs latitude/longitude in the metadata).
    analysis_sample_map           = false
    analysis_population_structure = true
    analysis_genetic_diversity    = true
    analysis_allele_frequencies   = true

    // Build the HTML report at the end.
    build_jupyter_book = true

    // Upper limits on resources per process; lower these to fit your machine.
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '240.h'

    // Where results go, and the container image registry/tag for the custom images.
    outdir           = 'results'
    publish_dir_mode = 'copy'
    help             = false
    version          = '0.8.0-nf'

    container_registry = 'ghcr.io/mishrap1971'
    container_tag      = '0.8'
}

// Resource labels, containers and output locations.
includeConfig 'conf/base.config'

// Run environments: pick one container engine (-profile docker|singularity|podman); 'test' uses the small test dataset.
profiles {

    docker {
        docker.enabled  = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    podman {
        podman.enabled = true
        docker.enabled = false
    }

    test { includeConfig 'conf/test.config' }

    debug {
        cleanup               = false
        process.beforeScript  = 'echo $HOSTNAME'
        dumpHashes            = true
    }
}

// Timestamped run reports (timeline, report, trace, dag) are written to <outdir>/pipeline_info/.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}

// Prints a short message when the run ends.
workflow.onComplete = {
    println ( workflow.success
        ? "\nAmpSeeker finished. Results: ${params.outdir}\n"
        : "\nAmpSeeker failed. See ${params.outdir}/pipeline_info/ for the trace.\n" )
}

// Pipeline metadata.
manifest {
    name            = 'AmpSeeker'
    author          = 'Sanjay Curtis Nagi and contributors'
    homePage        = 'https://github.com/mishrap1971/nf-ampseeker'
    description     = 'Amplicon sequencing analysis pipeline (Nextflow port)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = params.version
}
